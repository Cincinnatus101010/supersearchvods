# Optional: directory for cached transcripts (default ~/.supersearch/transcripts)
# SUPERSEARCH_CACHE_DIR=~/.supersearch/transcripts

# Optional: yt-dlp cookies file for age-restricted or login-required videos
# SUPERSEARCH_YTDLP_COOKIES=/path/to/cookies.txt

# Whisper fallback (install with: uv sync --extra whisper)
# SUPERSEARCH_WHISPER_MODEL=base
# SUPERSEARCH_WHISPER_WORKERS=4
# SUPERSEARCH_WHISPER_DL_WORKERS=8
# SUPERSEARCH_WHISPER_CHUNK_SEC=600
